{
  "name": "dsh-plugin-hub",
  "version": "0.2.5",
  "description": "Plugin Hub for DeepSeek Harness (DSH): a graphical app-store inside the Harness Web UI — browse, search, and one-click install GitHub dsh-plugins, with local ratings, dependency impact graphs, audit logging, and a development scaffold",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "cordis",
    "plugin-hub",
    "plugin-store",
    "plugin-marketplace",
    "web-ui",
    "one-click-install",
    "audit-log",
    "plugin-bundle"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunhuantian/dsh-plugin-hub.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/hub/src/host/index.d.ts",
      "default": "./lib/hub/src/host/index.js"
    },
    "./remote": {
      "types": "./lib/hub/src/contracts/remote.d.ts",
      "default": "./lib/hub/src/contracts/remote.js"
    },
    "./typert": {
      "types": "./lib/hub/src/contracts/remote.d.ts",
      "default": "./lib/hub/src/contracts/remote.js"
    },
    "./pricing": {
      "types": "./lib/hub/src/contracts/pricing.d.ts",
      "default": "./lib/hub/src/contracts/pricing.js"
    },
    "./extensions/store-db": {
      "types": "./lib/hub/src/extensions/store-db.d.ts",
      "default": "./lib/hub/src/extensions/store-db.js"
    },
    "./extensions/github": {
      "types": "./lib/hub/src/extensions/github.d.ts",
      "default": "./lib/hub/src/extensions/github.js"
    },
    "./extensions/npm-probe": {
      "types": "./lib/hub/src/extensions/npm-probe.d.ts",
      "default": "./lib/hub/src/extensions/npm-probe.js"
    },
    "./extensions/seed-catalog": {
      "types": "./lib/hub/src/extensions/seed-catalog.d.ts",
      "default": "./lib/hub/src/extensions/seed-catalog.js"
    },
    "./extensions/registry": {
      "types": "./lib/hub/src/extensions/registry.d.ts",
      "default": "./lib/hub/src/extensions/registry.js"
    },
    "./extensions/installer": {
      "types": "./lib/hub/src/extensions/installer.d.ts",
      "default": "./lib/hub/src/extensions/installer.js"
    },
    "./extensions/security": {
      "types": "./lib/hub/src/extensions/security.d.ts",
      "default": "./lib/hub/src/extensions/security.js"
    },
    "./extensions/conflict": {
      "types": "./lib/hub/src/extensions/conflict.d.ts",
      "default": "./lib/hub/src/extensions/conflict.js"
    },
    "./extensions/quality": {
      "types": "./lib/hub/src/extensions/quality.d.ts",
      "default": "./lib/hub/src/extensions/quality.js"
    },
    "./extensions/trust": {
      "types": "./lib/hub/src/extensions/trust.d.ts",
      "default": "./lib/hub/src/extensions/trust.js"
    },
    "./extensions/publish": {
      "types": "./lib/hub/src/extensions/publish.d.ts",
      "default": "./lib/hub/src/extensions/publish.js"
    },
    "./extensions/version-guard": {
      "types": "./lib/hub/src/extensions/version-guard.d.ts",
      "default": "./lib/hub/src/extensions/version-guard.js"
    },
    "./extensions/changelog": {
      "types": "./lib/hub/src/extensions/changelog.d.ts",
      "default": "./lib/hub/src/extensions/changelog.js"
    },
    "./extensions/usage": {
      "types": "./lib/hub/src/extensions/usage.d.ts",
      "default": "./lib/hub/src/extensions/usage.js"
    },
    "./extensions/health": {
      "types": "./lib/hub-health/src/index.d.ts",
      "default": "./lib/hub-health/src/index.js"
    },
    "./extensions/update-check": {
      "types": "./lib/hub/src/extensions/update-check.d.ts",
      "default": "./lib/hub/src/extensions/update-check.js"
    },
    "./extensions/dependency-graph": {
      "types": "./lib/hub/src/extensions/dependency-graph.d.ts",
      "default": "./lib/hub/src/extensions/dependency-graph.js"
    },
    "./extensions/baike": {
      "types": "./lib/hub-wiki/src/index.d.ts",
      "default": "./lib/hub-wiki/src/index.js"
    },
    "./extensions/skill-store": {
      "types": "./lib/hub/src/extensions/skill-store.d.ts",
      "default": "./lib/hub/src/extensions/skill-store.js"
    },
    "./extensions/backup": {
      "types": "./lib/hub/src/extensions/backup.d.ts",
      "default": "./lib/hub/src/extensions/backup.js"
    },
    "./extensions/diagnostics": {
      "types": "./lib/hub/src/extensions/diagnostics.d.ts",
      "default": "./lib/hub/src/extensions/diagnostics.js"
    },
    "./market-index": {
      "types": "./lib/hub-market-index/src/index.d.ts",
      "default": "./lib/hub-market-index/src/index.js"
    },
    "./client": {
      "types": "./lib/types/hub/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/market-index-format.md",
    "scripts/build-market-index.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:host": "tsc -p tsconfig.host.json",
    "build:types": "tsc -p tsconfig.client-types.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:types && npm run build:client",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "check:contract": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.2 <2.0.0",
    "@deepseek-ai/dsh-api-gateway": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "react": ">=18.2.0 <20.0.0"
  }
}
