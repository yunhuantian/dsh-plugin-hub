{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "lib/types",
    "rootDir": "src"
  },
  "include": ["src/contracts/**/*.ts", "src/client/**/*.ts", "src/client/**/*.tsx", "src/client/**/*.d.ts"],
  "exclude": ["src/client/_archived-*"]
}
