{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "lib/types",
    "rootDir": "packages"
  },
  "include": [
    "packages/hub/src/contracts/**/*.ts",
    "packages/hub/src/client/**/*.ts",
    "packages/hub/src/client/**/*.tsx",
    "packages/hub/src/client/**/*.d.ts"
  ]
}
