{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "outDir": "lib",
    "rootDir": "packages",
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/hub/src/contracts/**/*.ts",
    "packages/hub/src/host/**/*.ts",
    "packages/hub/src/extensions/**/*.ts",
    "packages/hub-market-index/src/**/*.ts",
    "packages/hub-score/src/**/*.ts",
    "packages/hub-health/src/**/*.ts",
    "packages/hub-wiki/src/**/*.ts"
  ]
}
